#!/bin/bash
# Fake mysqladmin: counters grow with time plus a random walk, so rates and sparklines move.
# State lives outside the repo so repeated runs can share it; MOCK_STATE overrides.
STATE=${MOCK_STATE:-/tmp/mysqlmonitor-mock}; mkdir -p "$STATE"
[[ -e $STATE/fail && $1 != status ]] && { echo "mysqladmin: connect to server at 'localhost' failed" >&2; echo "error: 'Access denied'" >&2; exit 1; }
[[ $1 == status ]] && { echo "Uptime: 1000  Threads: 3"; exit 0; }
ACC=$STATE/acc
read -r q r s o m < "$ACC" 2>/dev/null || { q=0; r=0; s=0; o=0; m=0; }
q=$((q + RANDOM % 3000)); r=$((r + RANDOM % 60)); s=$((s + RANDOM % 30)); o=$((o + RANDOM % 6)); m=$((m + RANDOM % 12))
echo "$q $r $s $o $m" > "$ACC"
t=$(( $(date +%s) - 1761000000 ))
run=$(( 1 + RANDOM % 15 )); tc=$(( 87 ))
row() { printf '| %-40s | %-20s |\n' "$1" "$2"; }
hdr() { echo "+------------------------------------------+----------------------+"; row Variable_name Value; echo "+------------------------------------------+----------------------+"; }
hdr
row Aborted_clients 1200; row Aborted_connects 34; row Aborted_connects_preauth 2
row Connections $((50000 + t)); row Created_tmp_disk_tables $((3000 + t/10)); row Created_tmp_files 12
row Created_tmp_tables $((90000 + t*2 + m)); row Innodb_buffer_pool_pages_free 4096; row Innodb_buffer_pool_pages_total 1572864
row Innodb_buffer_pool_read_requests $((900000000 + t*120000)); row Innodb_buffer_pool_reads $((800000 + r))
row Innodb_buffer_pool_wait_free 0; row Innodb_buffer_pool_write_requests $((40000000 + t*900))
row Innodb_data_reads $((820000 + r)); row Innodb_data_writes $((3000000 + t*40)); row Innodb_log_waits 0; row Innodb_log_writes $((2000000+t*30))
row Key_reads 3; row Key_writes 0; row Connection_errors_max_connections 0; row Innodb_os_log_written $((5000000000 + t*20000)); row Innodb_row_lock_time 1500; row Innodb_row_lock_waits 3; row Max_used_connections 212; row Max_used_connections_time "2026-10-11 01:02:03"
row Open_files 88; row Open_tables 4000; row Opened_tables $((20000 + o)); row Questions $((700000000 + t*300 + q))
row Select_full_join 41; row Select_scan $((100000 + s)); row Slow_queries $((2100 + q / 2000)); row Sort_merge_passes 3
row Sort_range 9000; row Sort_rows $((5000000 + t*3400)); row Sort_scan 700; row Table_locks_immediate 99000; row Table_locks_waited 0
row Table_open_cache_hits $((9000000 + t*500)); row Table_open_cache_misses $((20000 + o)); row Threads_cached 7
row Threads_connected $tc; row Threads_created $((100 + t/100)); row Threads_running $run; row Uptime $((1050000 + t)); row Uptime_since_flush_status 99
echo "+------------------------------------------+----------------------+"
hdr
row hostname db01; row version 10.11.6-MariaDB-0+deb12u1; row innodb_buffer_pool_size 25769803776; row innodb_page_size 16384; row max_connections 500; row table_open_cache 4000
row innodb_log_file_size 100663296; row innodb_log_files_in_group 1; row query_cache_type ON; row query_cache_size 1048576; row slow_query_log OFF; row long_query_time 10.000000; row open_files_limit 32190; row thread_cache_size 8; row tmp_table_size 16777216; row max_heap_table_size 16777216; row innodb_log_buffer_size 16777216; row sort_buffer_size 2097152; row key_buffer_size 134217728; row optimizer_switch "index_merge=on,index_merge_union=on"
echo "+------------------------------------------+----------------------+"
if [[ " $* " == *" processlist "* && ! -e $STATE/noprocs ]]; then
  el=$(( $(date +%s) % 100 ))
  echo "+------+-----------------+-----------------+----------+---------+------+--------------------------+------------------------------------------+----------+"
  echo "| Id   | User            | Host            | db       | Command | Time | State                    | Info                                     | Progress |"
  echo "+------+-----------------+-----------------+----------+---------+------+--------------------------+------------------------------------------+----------+"
  echo "| 1    | system user     |                 |          | Daemon  |      | InnoDB purge coordinator |                                          | 0.000    |"
  echo "| 5    | event_scheduler | localhost       |          | Daemon  | 9999 | Waiting on empty queue   |                                          | 0.000    |"
  echo "| 48211| wp              | localhost:41234 | stack_wp | Query   | $((el + 3)) | Sending data             | SELECT option_name, option_value FROM wp_options WHERE autoload = 'yes' AND option_name LIKE '%transient%' | 0.000    |"
  echo "| 48230| wp              | 10.0.0.5:5523   | stack_wp | Query   | 0    | Creating sort index      | SELECT * FROM wp_posts WHERE a='x|y' ORDER BY post_date | 0.000    |"
  echo "| 48240| app             | 10.0.0.9:6000   | shop     | Query   | 75   | Copying to tmp table     | SELECT o.id,"
  echo "    c.name FROM orders o"
  echo "    JOIN customers c ON c.id = o.cid | 0.000    |"
  printf '| 48250| evil            | localhost       | shop     | Query   | 1    | executing                | SELECT "\033[2J\033[31mPWNED" | 0.000    |\n'
  for i in 1 2 3; do echo "| 4900$i| wp              | localhost       | stack_wp | Sleep   | 12   |                          |                                          | 0.000    |"; done
  echo "| 49999| root            | localhost       |          | Query   | 0    | starting                 | show processlist                         | 0.000    |"
  echo "+------+-----------------+-----------------+----------+---------+------+--------------------------+------------------------------------------+----------+"
fi
